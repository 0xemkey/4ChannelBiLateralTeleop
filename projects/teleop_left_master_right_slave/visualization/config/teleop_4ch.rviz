Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 38; 40; 44
    Fixed Frame: teleop_4ch_world
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/MarkerArray
      Name: Display-only telemetry
      Enabled: true
      Topic:
        Value: /teleop_4ch_sim/visualization/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.6
      Pitch: 0.5
      Yaw: 0.8
      Focal Point: {X: 0.05, Y: 0.04, Z: 0.02}
Window Geometry:
  Width: 1200
  Height: 850
